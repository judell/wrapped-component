            yAxis: { type: 'value' },
            brush: { toolbox: ['rect', 'polygon', 'lineX', 'lineY', 'keep', 'clear'], xAxisIndex: 0 },
            toolbox: { feature: { brush: { type: ['rect', 'polygon', 'lineX', 'lineY', 'keep', 'clear'] } } },
            series: [{ type: 'bar', name: 'Values', data: [30, 50, 70, 40, 60, 80, 20, 90] }],
            legend: {},
            tooltip: { trigger: 'axis' }
          }
        }" />
      </Card>

      <H2>Line with timeline</H2>
      <Card>
        <EChart id="cat-timeline" height="400px" option="{
          {
            baseOption: {
              timeline: {
                axisType: 'category',
                data: ['2020', '2021', '2022', '2023'],
                autoPlay: false,
                playInterval: 1500
              },
              xAxis: { type: 'category', data: ['Q1', 'Q2', 'Q3', 'Q4'] },
              yAxis: { type: 'value' },
              legend: {},
              tooltip: { trigger: 'axis' }
            },
            options: [
              { series: [{ type: 'bar', name: 'Revenue', data: [100, 120, 140, 160] }] },
              { series: [{ type: 'bar', name: 'Revenue', data: [130, 150, 170, 200] }] },
              { series: [{ type: 'bar', name: 'Revenue', data: [160, 180, 210, 240] }] },
              { series: [{ type: 'bar', name: 'Revenue', data: [200, 220, 260, 300] }] }
            ]
          }
        }" />
      </Card>

      <H2>Parallel coordinates</H2>
      <Card>
        <EChart id="cat-parallel" height="350px" option="{
          {
            parallelAxis: [
              { dim: 0, name: 'Price' },
              { dim: 1, name: 'Rating' },
              { dim: 2, name: 'Sales' },
              { dim: 3, name: 'Stock' }
            ],
            series: [{
              type: 'parallel',
              data: [
                [12, 4.5, 200, 50],
                [18, 3.8, 150, 30],
                [25, 4.2, 300, 80],
                [8, 4.9, 100, 20],
                [30, 3.5, 250, 60]
              ],
              lineStyle: { width: 2, opacity: 0.6 }
            }],
            tooltip: {}
          }
        }" />
      </Card>

      <H2>Sunburst</H2>
      <Card>
        <EChart id="cat-sunburst" height="400px" option="{
          {
            series: [{
              type: 'sunburst',
              data: [
                { name: 'Engineering', children: [
                  { name: 'Frontend', value: 15 },
                  { name: 'Backend', value: 18 },
                  { name: 'DevOps', value: 7 }
                ]},
                { name: 'Product', children: [
                  { name: 'Design', value: 10 },
                  { name: 'PM', value: 8 }
                ]},
                { name: 'Sales', children: [
                  { name: 'Enterprise', value: 12 },
                  { name: 'SMB', value: 8 }
                ]}
              ],
              radius: ['15%', '90%'],
              label: { rotate: 'radial' }
            }],
            tooltip: {}
          }
        }" />
      </Card>

    </VStack>
  </Page>


  </Pages>

  <ModalDialog
    id="inspectorDialog"
    title="XMLUI Inspector"
    minWidth="85vw"
    minHeight="85vh">
    <IFrame src="xs-diff.html" width="100%" height="80vh" />
  </ModalDialog>
</App>