    <Page url="/slider-and-sliderw">
      <VStack padding="{responsive('0.75rem', '2rem')}" gap="0">

        <H1>
          Slider and SliderW
        </H1>

        <Markdown>
          Both components wrap the same `SliderNative.tsx` React component.
**Slider** uses a hand-written 40-line renderer.
**SliderW** uses `wrapComponent` (13 lines).
These tests confirm they behave identically for all currently-wrapped features.
        </Markdown>

        <!-- === Basic usage === -->
        <Card var.sliderVal="" var.sliderWVal="">
          <H2>
            Basic: default props
          </H2>
          <HStack wrapContent="{true}">
            <VStack width="{responsive('100%', '50%')}">
              <Text fontWeight="bold">
                Slider
              </Text>
              <Slider id="s1" onDidChange="{(v) => sliderVal = v}" />
              <Text>
                Value: {sliderVal}
              </Text>
            </VStack>
            <SpaceFiller />
            <VStack width="{responsive('100%', '50%')}">
              <Text fontWeight="bold">
                SliderW
              </Text>
              <SliderW id="sw1" onDidChange="{(v) => sliderWVal = v}" />
              <Text>
                Value: {sliderWVal}
              </Text>
            </VStack>
          </HStack>
        </Card>

        <!-- === Custom range === -->
        <Card var.s2Val="" var.sw2Val="">
          <H2>
            Custom range: 0–100, step 10
          </H2>
          <HStack wrapContent="{true}">
            <VStack width="{responsive('100%', '50%')}">
              <Text fontWeight="bold">
                Slider
              </Text>
              <Slider
                id="s2"
                minValue="0"
                maxValue="100"
                step="10"
                initialValue="50"
                onDidChange="{(v) => s2Val = v}" />
              <Text>
                Value: {s2Val}
              </Text>
            </VStack>
            <SpaceFiller />
            <VStack width="{responsive('100%', '50%')}">
              <Text fontWeight="bold">
                SliderW
              </Text>
              <SliderW
                id="sw2"
                minValue="0"
                maxValue="100"
                step="10"
                initialValue="50"
                onDidChange="{(v) => sw2Val = v}" />
              <Text>
                Value: {sw2Val}
              </Text>
            </VStack>
          </HStack>
        </Card>

        <!-- === Boolean props === -->
        <Card>
