          height="350px"
          option="{
            {
              xAxis: { type: 'category', data: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'] },
              yAxis: { type: 'value' },
              series: [
                { type: 'bar', name: 'Revenue', data: [120, 200, 150, 80, 70, 110, 130] },
                { type: 'bar', name: 'Expenses', data: [80, 120, 90, 60, 50, 80, 100] }
