<Component name="SimplePieChart">
  <EChart
    height="{$props.height || '350px'}"
    option="{
      {
        series: [{
          type: 'pie',
          radius: $props.radius || ['40%', '70%'],
          data: $props.data.map(function(d) { return { value: d[$props.valueKey], name: d[$props.nameKey] } })
        }],
        tooltip: { trigger: 'item' },
        legend: { bottom: 0, left: 'center' }
      }
    }" />
</Component>
